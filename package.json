{
  "name": "qa-forge-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive Playwright TypeScript end-to-end automation for QA Forge",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "node scripts/generate-allure.mjs",
    "allure:open": "allure open allure-report",
    "pretest": "node scripts/clean-results.mjs",
    "pretest:chromium": "node scripts/clean-results.mjs",
    "pretest:smoke": "node scripts/clean-results.mjs",
    "plan:generate": "node scripts/generate-test-plan.mjs",
    "coverage:check": "node scripts/check-coverage.mjs",
    "results:summary": "node scripts/summarize-results.mjs",
    "results:gate": "node scripts/summarize-results.mjs --gate",
    "security:scan": "node scripts/scan-secrets.mjs",
    "verify": "npm run typecheck && npm run coverage:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.2",
    "allure-commandline": "2.43.0",
    "allure-js-commons": "3.12.1",
    "allure-playwright": "3.12.1",
    "dotenv": "17.4.2",
    "typescript": "7.0.2"
  }
}
